#!/bin/sh /etc/rc.common
# U01 信号灯：有网络亮蓝、没网络亮红（灯走 leds class，不用占 cdev line）
START=98
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/netled.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
