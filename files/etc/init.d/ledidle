#!/bin/sh /etc/rc.common
# U01 按键守夜：3 分钟没按按键把所有灯盖灭（牌子 /tmp/leds_dark 给 netled/batled 看）
START=96
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/ledidle.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
