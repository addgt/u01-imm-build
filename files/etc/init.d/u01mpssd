#!/bin/sh /etc/rc.common
# U01 MPSS 定点点火服务：原厂 LTE L1 在 MBA+900s 必断言，断言的崩溃路径会带着
# 活着的 bam-dmux 会话给 MSS 断电，实测就是整机硬复位。本服务赶在断言前把会话
# 拆干净再 stop/start remoteproc0，让计时器重新起算。
# 逻辑全在 /usr/libexec/u01mpssd.sh，这个文件只负责 procd 外壳。
START=96
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/libexec/u01mpssd.sh ] || return 1
	procd_open_instance u01mpssd
	procd_set_param command /bin/sh /usr/libexec/u01mpssd.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
