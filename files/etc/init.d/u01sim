#!/bin/sh /etc/rc.common
# U01 读卡常驻：SIM 的两根供电脚（119=托盘卡槽 / 14=内置卡）走 cdev line ABI，
# 进程一退出 line 就释放、脚掉回默认电平，卡就断电 —— 所以必须常驻，不能一次性设置。
START=25
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/u01simd.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
