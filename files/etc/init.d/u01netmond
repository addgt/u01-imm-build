#!/bin/sh /etc/rc.common
# U01 蜂窝自愈看门狗：MPSS 崩一次，ModemManager 就把对象重编号，netifd 那段拿到旧对象
# 之后再也不会自己连回来（实测恒 up=false）。这里每 30 秒对账一次，条件齐了才 ifup 一次。
# 逻辑都在 /usr/libexec/u01netmond.sh，这个文件只负责被 procd 盯着跑。
START=97
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/libexec/u01netmond.sh ] || return 1
	procd_open_instance u01netmond
	procd_set_param command /bin/sh /usr/libexec/u01netmond.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
