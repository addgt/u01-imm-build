+static void pm8916_lbc_charger_log_state(struct pm8916_lbc_charger *chg)
+{
+	unsigned int vdd = 0, ibat = 0, vin = 0, ctrl = 0;
+	unsigned int st = 0, fail = 0, pres = 0, temp = 0;
+
+	regmap_read(chg->regmap, chg->reg[LBC_CHGR] + PM8916_LBC_CHGR_VDD_MAX, &vdd);
+	regmap_read(chg->regmap, chg->reg[LBC_CHGR] + PM8916_LBC_CHGR_IBAT_MAX, &ibat);
+	regmap_read(chg->regmap, chg->reg[LBC_CHGR] + PM8916_LBC_CHGR_VIN_MIN, &vin);
+	regmap_read(chg->regmap, chg->reg[LBC_CHGR] + PM8916_LBC_CHGR_CHG_CTRL, &ctrl);
+	regmap_read(chg->regmap, chg->reg[LBC_CHGR] + PM8916_LBC_CHGR_CHG_STATUS, &st);
+	regmap_read(chg->regmap, chg->reg[LBC_CHGR] + PM8916_LBC_CHGR_CHG_FAILED, &fail);
+	regmap_read(chg->regmap, chg->reg[LBC_BAT_IF] + PM8916_LBC_BAT_IF_PRES_STATUS, &pres);
+	regmap_read(chg->regmap, chg->reg[LBC_BAT_IF] + PM8916_LBC_BAT_IF_TEMP_STATUS, &temp);
+
+	dev_info(chg->dev, "charge gates: VDD_MAX=0x%02x IBAT_MAX=0x%02x VIN_MIN=0x%02x CHG_CTRL=0x%02x CHG_STATUS=0x%02x CHG_FAILED=0x%02x BAT_PRES=0x%02x TEMP_OK=0x%02x\n",
+		 vdd, ibat, vin, ctrl, st, fail, pres, temp);
+}
