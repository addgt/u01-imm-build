+static void bam_dma_disable_irq(struct bam_device *bdev)
+{
+	int was_disabled;
+
+	mutex_lock(&bdev->irq_disable_lock);
+	/* 0 = enabled, 1 = disabled, 2 = disable in progress. */
+	was_disabled = atomic_xchg(&bdev->irq_disabled, 2);
+
+	cancel_delayed_work_sync(&bdev->irq_resume_work);
+	if (!was_disabled)
+		disable_irq(bdev->irq);
+	synchronize_irq(bdev->irq);
+
+	tasklet_kill(&bdev->task);
+	cancel_delayed_work_sync(&bdev->irq_resume_work);
+	atomic_set(&bdev->irq_disabled, 1);
+	mutex_unlock(&bdev->irq_disable_lock);
+}
+
+static void bam_dma_enable_irq(struct bam_device *bdev)
+{
+	if (atomic_cmpxchg(&bdev->irq_disabled, 1, 0) != 1)
+		return;
+
+	enable_irq(bdev->irq);
+}
