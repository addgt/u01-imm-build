+static void bam_dma_free_chan_offline(struct dma_chan *chan)
+{
+	struct bam_chan *bchan = to_bam_chan(chan);
+	struct bam_device *bdev = bchan->bdev;
+	struct bam_async_desc *async_desc, *tmp;
+	struct virt_dma_desc *vd, *_vd;
+	unsigned long flags;
+	LIST_HEAD(head);
+
+	if (!bchan->fifo_virt || bchan->offline)
+		return;
+
+	bam_dma_quiesce_offline(chan);
+	vchan_synchronize(&bchan->vc);
+
+	spin_lock_irqsave(&bchan->vc.lock, flags);
+	list_for_each_entry_safe(async_desc, tmp, &bchan->desc_list, desc_node) {
+		list_del(&async_desc->desc_node);
+		list_add(&async_desc->vd.node, &bchan->vc.desc_issued);
+	}
+	vchan_get_all_descriptors(&bchan->vc, &head);
+	list_for_each_entry_safe(vd, _vd, &head, node)
+		dmaengine_desc_clear_reuse(&vd->tx);
+	spin_unlock_irqrestore(&bchan->vc.lock, flags);
+	vchan_dma_desc_free_list(&bchan->vc, &head);
+
+	bchan->head = 0;
+	bchan->tail = 0;
+	bchan->initialized = 0;
+	bchan->paused = 0;
+	bchan->reconfigure = 1;
+	/* Keep the hardware FIFO until the controller is reset on reallocation. */
+	bchan->offline = true;
+	bdev->active_channels--;
 }
 
