+/*
+ * Modem restart handling.
+ *
+ * Both rings are only retired by a DMA completion callback from the remote
+ * side, so restarting MPSS with a live data session leaves them describing
+ * the previous modem instance: TX never frees its cursor again (ndo_open
+ * returns -EAGAIN for the rest of the boot) and RX silently delivers
+ * nothing, without a single error in the log.
+ *
+ * The rings are still torn down before the remote loses power, but rebuilt
+ * only once it is powered again - never in prepare(), which rproc runs while
+ * the block has no power at all, and that is what reset the machine. The
+ * netdevs stay attached, because a restarted modem does not open its
+ * channels by itself - it only answers the BAM_DMUX_CMD_OPEN that ndo_open
+ * sends - so detaching would turn "un-openable because TX is stuck" into
+ * "un-openable because of ENETDOWN" and fix nothing.
+ */
+static void bam_dmux_tx_flush(struct bam_dmux *dmux)
+{
+	unsigned long flags;
+	int i, dropped = 0;
+
+	if (dmux->tx)
+		dmaengine_terminate_sync(dmux->tx);
+
+	spin_lock_irqsave(&dmux->tx_lock, flags);
+	dmux->tx_next_skb = 0;
+	atomic_long_set(&dmux->tx_deferred_skb, 0);
+	for (i = 0; i < BAM_DMUX_NUM_SKB; i++) {
+		struct bam_dmux_skb_dma *skb_dma = &dmux->tx_skbs[i];
+
+		if (!skb_dma->skb)
+			continue;
+
+		/* Unmap reads skb->len, so it has to happen before the skb goes. */
+		if (skb_dma->addr)
+			bam_dmux_skb_dma_unmap(skb_dma, DMA_TO_DEVICE);
+		dev_kfree_skb_any(skb_dma->skb);
+		skb_dma->skb = NULL;
+		dropped++;
+	}
+	spin_unlock_irqrestore(&dmux->tx_lock, flags);
+
+	/* Each queued buffer holds one runtime-PM reference; drop them the way
+	 * the completion callback does, outside the lock.
+	 */
+	for (i = 0; i < dropped; i++) {
+		pm_runtime_mark_last_busy(dmux->dev);
+		pm_runtime_put_autosuspend(dmux->dev);
+	}
+}
+
+/* Same arm sequence as bam_dmux_power_on(), for a channel that stayed
+ * requested across the restart: the buffers have to be handed back to the
+ * DMA engine before the new modem instance can write into them.
+ */
+static bool bam_dmux_rx_rearm(struct bam_dmux *dmux)
+{
+	int i;
+
+	for (i = 0; i < BAM_DMUX_NUM_SKB; i++) {
+		if (!bam_dmux_skb_dma_queue_rx(&dmux->rx_skbs[i], GFP_KERNEL)) {
+			dev_err(dmux->dev, "Failed to re-arm RX buffer %d\n", i);
+			return false;
+		}
+	}
+
+	dma_async_issue_pending(dmux->rx);
+	return true;
+}
+
+/* The BAM lives in the MSS power domain, so no BAM register may be read or
+ * written while the remote is down: the access does not time out, it hangs the
+ * bus, and the PON watchdog resets the AP without an oops or a ramoops record.
+ * The pc line comes out of SMEM instead, so it stays readable either way and
+ * can be asked directly whether the block is powered right now.
+ */
+static bool bam_dmux_pc_is_up(struct bam_dmux *dmux)
+{
+	bool level;
+
+	if (irq_get_irqchip_state(dmux->pc_irq, IRQCHIP_STATE_LINE_LEVEL, &level))
+		return dmux->pc_state;
+
+	return level;
+}
+
+/* Hand the rings back to the new modem instance. Callers must have established
+ * that the BAM is powered; this is what clears ->dead, so nothing may reach the
+ * engine through here before that condition holds.
+ */
+static bool bam_dmux_rearm(struct bam_dmux *dmux)
+{
+	if (!dmux->dead)
+		return true;
+
+	/* A crash leaves the old descriptors linked in the DMA driver. They
+	 * cannot be terminated while the BAM has no power; do it now, before
+	 * queuing anything new, or the old ring would be issued a second time.
+	 */
+	bam_dmux_tx_flush(dmux);
+
+	if (dmux->rx) {
+		dmaengine_terminate_sync(dmux->rx);
+		bam_dmux_free_skbs(dmux->rx_skbs, DMA_FROM_DEVICE);
+		if (!bam_dmux_rx_rearm(dmux))
+			return false;
+	} else if (!bam_dmux_power_on(dmux)) {
+		dev_err(dmux->dev, "Failed to re-arm RX after modem restart\n");
+		return false;
+	}
+
+	/* A restarted remote waits on this ack just like the first one did. */
+	bam_dmux_pc_ack(dmux);
+
+	/* The pc-ack path drops the TX channel on the way down and nothing
+	 * else picks it back up: the device never becomes runtime-suspended
+	 * here, so runtime_resume() does not run either.
+	 */
+	if (!dmux->tx) {
+		dmux->tx = dma_request_chan(dmux->dev, "tx");
+		if (IS_ERR(dmux->tx)) {
+			dev_err(dmux->dev, "Failed to get TX channel: %pe\n", dmux->tx);
+			dmux->tx = NULL;
+			return false;
+		}
+	}
+
+	dmux->dead = false;
+	dmux->pc_state = true;
+	bam_dmux_tx_wake_queues(dmux);
+	dev_info(dmux->dev, "BAM armed, remote is up\n");
+
+	return true;
+}
+
+static int bam_dmux_subdev_prepare(struct rproc_subdev *subdev)
+{
+	struct bam_dmux *dmux = container_of(subdev, struct bam_dmux, subdev);
+
+	/* rproc runs this before the remote is powered, so arming here is what
+	 * used to reset the machine. Re-enabling the pc interrupt is all it
+	 * takes: the new instance signals power through it, and the first
+	 * ndo_open after that asks the line directly as a fallback.
+	 */
+	if (dmux->restart_pending)
+		enable_irq(dmux->pc_irq);
+
+	/* Never fail here: an error would abort the modem boot for no reason. */
+	return 0;
+}
+
+static void bam_dmux_subdev_stop(struct rproc_subdev *subdev, bool crashed)
+{
+	struct bam_dmux *dmux = container_of(subdev, struct bam_dmux, subdev);
+
+	/* Close the door first: from here on the engine is about to lose
+	 * power, and any caller that still reaches it takes the AP down with
+	 * it. Crashed means the collapse already happened, so not even the
+	 * rings may be touched; rearm() terminates and frees them only after
+	 * the new instance has powered the BAM back up.
+	 */
+	dmux->dead = true;
+	disable_irq(dmux->pc_irq);
+	cancel_work_sync(&dmux->tx_wakeup_work);
+	dev_info(dmux->dev, "Modem going down: BAM access gated\n");
+
+	if (!crashed) {
+		bam_dmux_tx_flush(dmux);
+
+		if (dmux->rx)
+			dmaengine_terminate_sync(dmux->rx);
+		bam_dmux_free_skbs(dmux->rx_skbs, DMA_FROM_DEVICE);
+	}
+
+	/* Nothing is open until the remote says so, after a restart. */
+	bitmap_zero(dmux->remote_channels, BAM_DMUX_NUM_CH);
+
+	dmux->restart_pending = true;
+}
+
+static int bam_dmux_match_rproc(struct device *dev, const void *data)
+{
+	return dev->class && !strcmp(dev->class->name, "remoteproc");
+}
+
+/*
+ * The bam-dmux device is created by the modem remoteproc driver below the
+ * same parent, so its sibling with the "remoteproc" class is the modem this
+ * data path belongs to. Hooking it that way keeps the DTB untouched; on a
+ * platform where the topology differs we just stay with the upstream
+ * behaviour of a session that lives as long as it boots.
+ */
+static void bam_dmux_attach_modem(struct bam_dmux *dmux)
+{
+	struct device *rdev;
+
+	if (!dmux->dev->parent)
+		return;
+
+	rdev = device_find_child(dmux->dev->parent, NULL, bam_dmux_match_rproc);
+	if (!rdev) {
+		dev_info(dmux->dev, "No modem remoteproc sibling, restart unsupported\n");
+		return;
+	}
+
+	dmux->rproc = container_of(rdev, struct rproc, dev);
+	dmux->rdev = rdev;
+	dmux->subdev.prepare = bam_dmux_subdev_prepare;
+	dmux->subdev.stop = bam_dmux_subdev_stop;
+	rproc_add_subdev(dmux->rproc, &dmux->subdev);
+
+	dev_info(dmux->dev, "Modem restart hooked to %s\n", dmux->rproc->name);
+}
