+	synchronize_net();
+	if (sync_reopen)
+		cancel_delayed_work_sync(&dmux->reopen_work);
+	cancel_delayed_work_sync(&dmux->register_netdev_work);
+	cancel_delayed_work_sync(&dmux->tx_wakeup_work);
+	cancel_delayed_work_sync(&dmux->rx_refill_work);
