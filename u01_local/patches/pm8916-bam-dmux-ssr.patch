+	WRITE_ONCE(dmux->rx_stopped, true);
+	bitmap_zero(dmux->rx_refill_pending, BAM_DMUX_NUM_SKB);
+	spin_unlock_irqrestore(&dmux->rx_lock, flags);
+	rtnl_lock();
+	spin_lock_irqsave(&dmux->tx_lock, flags);
+	bam_dmux_tx_stop_queues(dmux);
+	spin_unlock_irqrestore(&dmux->tx_lock, flags);
+	spin_lock_irqsave(&dmux->state_lock, flags);
+	WRITE_ONCE(dmux->replay_pending, true);
+	bitmap_zero(dmux->remote_channels, BAM_DMUX_NUM_CH);
+	spin_unlock_irqrestore(&dmux->state_lock, flags);
+	rtnl_unlock();
