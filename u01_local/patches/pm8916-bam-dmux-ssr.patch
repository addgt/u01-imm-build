+static void bam_dmux_reopen_work(struct work_struct *work)
+{
+	struct bam_dmux *dmux = container_of(work, struct bam_dmux, reopen_work.work);
+	struct rproc *rproc = READ_ONCE(dmux->rproc);
+
+	if (rproc)
+		mutex_lock(&rproc->lock);
+	rtnl_lock();
+	bam_dmux_rearm(dmux);
+	rtnl_unlock();
+	if (rproc)
+		mutex_unlock(&rproc->lock);
+}
+
+static bool bam_dmux_pc_is_up(struct bam_dmux *dmux)
+{
+	bool level;
+
+	if (irq_get_irqchip_state(dmux->pc_irq, IRQCHIP_STATE_LINE_LEVEL, &level))
+		return dmux->pc_state;
+
+	return level;
+}
+
+static bool bam_dmux_can_touch(struct bam_dmux *dmux)
+{
+	return !READ_ONCE(dmux->dead) &&
+	       !READ_ONCE(dmux->restart_pending) &&
+	       bam_dmux_pc_is_up(dmux);
+}
