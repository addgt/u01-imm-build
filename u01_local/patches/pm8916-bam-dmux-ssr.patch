+	if (READ_ONCE(dmux->dead) && !READ_ONCE(dmux->restart_pending) &&
+	    bam_dmux_pc_is_up(dmux))
+		schedule_delayed_work(&dmux->reopen_work, BAM_DMUX_REOPEN_DELAY);
